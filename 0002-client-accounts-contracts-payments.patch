+  reviewedBy String?
+
+  signedAt        DateTime?
+  signerName      String?
+  signerIp        String?
+  signerUserAgent String?
+
+  payments Payment[]
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  @@index([userId])
+  @@index([status])
+}
+
+model Payment {
