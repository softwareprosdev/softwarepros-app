+        ) : (
+          <>
+            Get Pricing & Contract <Icon name="arrow-right" className="ml-1 text-xs" />
+          </>
+        )}
+      </button>
+      {state === "error" && (
+        <p role="alert" className="text-xs text-red-400 mt-2">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+}
