# Copy to .env and fill in real values. Never commit a populated .env.

# PostgreSQL connection string the app uses for its own runtime queries
# (src/lib/prisma.ts). Safe to point at a connection pooler (e.g. Supabase's
# transaction-mode pooler on :6543) — this one is never used for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/softwarepros?schema=public"

# PostgreSQL connection string the Prisma CLI uses for `migrate deploy`
# (scripts/db-migrate.sh, wired through prisma.config.ts). This one MUST be
# a session-mode or direct (non-pooled) connection: `migrate deploy` holds
# an advisory lock across statements, and a transaction-mode pooler hands
# out a different physical connection per statement, so the lock can never
# be observed and the migration hangs forever instead of failing. On
# Supabase this is either db.<ref>.supabase.co:5432 (direct) or the same
# pooler host on :5432 instead of :6543 (session mode).
DIRECT_URL="postgresql://user:password@localhost:5432/softwarepros?schema=public"

# ── AI Architect credentials (pick one route) ───────────────────────────
# The AI Discovery Center needs exactly one of the two keys below. Set
# REQUESTY_API_KEY and every call routes through Requesty; leave it empty and
# the app talks to Anthropic directly with ANTHROPIC_API_KEY. If both are set,
# Requesty wins.

# Requesty (https://requesty.ai) — an Anthropic-compatible gateway: one key,
# a choice of upstream model, and usage/spend visible in their dashboard.
# From the Requesty dashboard: API Keys.
REQUESTY_API_KEY=""

# Optional. Defaults to https://router.requesty.ai. Set this to
# https://router.eu.requesty.ai for Requesty's EU data-residency endpoint.
REQUESTY_BASE_URL=""

# Optional. Requesty addresses models as "provider/model", so the app sends
# "anthropic/claude-haiku-5" by default rather than the bare Anthropic id.
# Requesty's catalogue moves independently of Anthropic's — pin the exact id
# here (e.g. "anthropic/claude-sonnet-5", or a "policy/..." id) if the default
# ever stops resolving, rather than waiting for a patch. Ignored unless
# REQUESTY_API_KEY is set.
REQUESTY_MODEL=""

# Anthropic API key — the direct route, used only when REQUESTY_API_KEY is
# empty. ANTHROPIC_AUTH_TOKEN works here too; the app treats either as
# configured.
ANTHROPIC_API_KEY=""

# ── Client accounts (Supabase Auth) ─────────────────────────────────────
# Same Supabase project as DATABASE_URL/DIRECT_URL above — from the
# Supabase dashboard: Project Settings -> API. These two are safe to expose
# to the browser (that's what NEXT_PUBLIC_ means here); Supabase's Row Level
# Security, not secrecy of these values, is what protects data. Required for
# signup/login and for /discovery, /account and /contract to work at all.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Payments (Stripe) ────────────────────────────────────────────────────
# From the Stripe dashboard: Developers -> API keys. Server-only — never
# prefix this with NEXT_PUBLIC_. Start with a test-mode secret key
# (sk_test_...) and test end to end before ever switching to a live key.
STRIPE_SECRET_KEY=""

# From the Stripe dashboard: Developers -> Webhooks, after adding an
# endpoint for https://<your-domain>/api/webhooks/stripe listening for
# checkout.session.completed. Without this set, a deposit payment
# completes on Stripe's side but this app never finds out.
STRIPE_WEBHOOK_SECRET=""

# ── Lead notifications (Resend, optional) ───────────────────────────────
# Sends an email to info@softwarepros.org every time the lead form (contact
# page, homepage, summary page) is submitted. Leave RESEND_API_KEY empty and
# this stays inert — the lead still saves to the database and shows up in
# /admin/leads, it just doesn't also email anyone.
# From the Resend dashboard: API Keys.
RESEND_API_KEY=""

# Optional. Resend rejects a `from` address on a domain you haven't verified
# in their dashboard, so this defaults to their shared onboarding domain
# (onboarding@resend.dev), which works immediately but looks like a test
# sender. Verify softwarepros.org in Resend, then set this to an address on
# it, e.g. "SoftwarePros <leads@softwarepros.org>".
RESEND_FROM_EMAIL=""

# Admin area (/admin/*, /api/admin/*) — HTTP Basic auth.
# Leaving ADMIN_PASSWORD empty disables admin access entirely (fails closed).
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# Public origin, used for metadata and absolute URLs.
# In production this MUST be the real origin: canonical URLs, sitemap.xml,
# robots.txt, llms.txt, ai.txt, security.txt and every Open Graph URL are
# generated from it, and a wrong value fails silently.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Voice (optional) ────────────────────────────────────────────────────
# ElevenLabs text-to-speech, so the AI Architect speaks its replies. Claude
# still does the thinking; this only gives it a voice.
#
# Leave ELEVENLABS_API_KEY empty and the whole feature stays inert: replies
# arrive as text, the orb still reacts to the microphone, nothing errors.
#
# Billing is per character, so /api/speech caps request length and is rate
# limited more tightly than the chat route.
ELEVENLABS_API_KEY=""

# Optional. Defaults to a stock voice; override once you have auditioned one.
ELEVENLABS_VOICE_ID=""

# Optional. Defaults to eleven_flash_v2_5 — the low-latency model, chosen
# because time-to-first-sound matters more than fidelity in conversation.
ELEVENLABS_MODEL_ID=""

# The same key also powers dictation (ElevenLabs Scribe), which replaced the
# browser's Web Speech API — that streamed audio to the browser vendor and
# failed on healthy connections. No extra credential is needed.
#
# Optional. Defaults to scribe_v1. ElevenLabs revises the model line, so if
# /api/transcribe starts logging a 422, set the current id here rather than
# waiting for a patch. GET /api/admin/voice-check reports what is configured.
ELEVENLABS_STT_MODEL_ID=""

# Optional. Left empty, Scribe detects the language. Pin it (e.g. "en") only
# if you know your visitors speak one — detection can mistake a short
# utterance for the wrong language.
ELEVENLABS_STT_LANGUAGE=""
